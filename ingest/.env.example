# Direct Anthropic access for the ingestion scripts.
ANTHROPIC_API_KEY=sk-ant-...

# Alternative to the key above: route classification through a temporary
# worker-side proxy that uses the Worker's own ANTHROPIC_API_KEY secret.
# The /admin/classify endpoint is added for a run and removed afterwards —
# see git history for the implementation.
# CLASSIFY_PROXY_URL=https://<worker>.workers.dev/admin/classify

# Required by `npm run load`, and by run.ts when auto-loading after a pass.
# WORKER_ADMIN_URL=https://<worker>.workers.dev
# WORKER_ADMIN_TOKEN=<the Worker's ADMIN_TOKEN secret>
